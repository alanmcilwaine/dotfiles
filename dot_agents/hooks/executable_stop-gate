#!/usr/bin/env bash
# Stop hook: run the project's checks before the agent may finish.
# Exit 2 blocks the stop and sends stderr back to the agent.
set -euo pipefail

source "${BASH_SOURCE[0]%/*}/lib.sh"
require_command jq

readonly MAX_BLOCKS=3
readonly OUTPUT_LINES=60
readonly STATE_DIR="${TMPDIR:-/tmp}/agents-stop-gate"

# Claude Code treats a hook that crashes as passed and shows the agent nothing,
# so a bug in this script would skip the checks without a trace. A crash blocks
# the stop once for each session and tells the agent to report it.
report_crash() {
    local line="$1" reported="$STATE_DIR/${session_id:-unknown}.crashed"
    mkdir -p "$STATE_DIR"
    if [[ -e "$reported" ]]; then
        exit 0
    fi
    touch "$reported"
    {
        echo "stop-gate: the gate itself failed at line $line, so the project's checks did not run."
        echo "This is a bug in the gate and not in your work. Do not try to fix it."
        echo "Say in your final reply that the checks did not run and give this message."
    } >&2
    exit 2
}
trap 'report_crash "$LINENO"' ERR

# Hash the commit, the uncommitted changes and the untracked files, so the
# checks run once for each distinct state of the working tree. A repository
# with no commit yet is identified by its untracked files alone.
#
# Everything runs from the top of the working tree. The agent may stop inside
# a subdirectory, where git lists untracked files relative to that directory
# and git hash-object reads them relative to the top.
working_tree_fingerprint() {
    local top
    top="$(git -C "$1" rev-parse --show-toplevel)"
    {
        git -C "$top" rev-parse --verify HEAD
        git -C "$top" diff HEAD
        git -C "$top" ls-files --others --exclude-standard
        (cd "$top" && git ls-files --others --exclude-standard | git hash-object --stdin-paths)
    } 2>/dev/null | shasum -a 256 | cut -d ' ' -f 1
}

input="$(cat)"
project_dir="$(hook_field "$input" cwd)"
session_id="$(hook_field "$input" session_id)"
[[ -n "$project_dir" ]] || { echo "stop-gate: hook input has no cwd" >&2; exit 1; }
[[ -n "$session_id" ]] || { echo "stop-gate: hook input has no session_id" >&2; exit 1; }

overlay="$(overlay_dir "$project_dir")" || exit 0
checks="$overlay/checks.sh"
[[ -e "$checks" ]] || exit 0

# The agent can stop in the folder that holds a bare repository and its
# worktrees. That folder has no working tree to check, and saying so keeps the
# skipped checks visible.
if [[ "$(git -C "$project_dir" rev-parse --is-inside-work-tree 2>/dev/null)" != true ]]; then
    jq -n --arg message "stop-gate: $project_dir is not a working tree, so the project's checks did not run. Run $checks from the worktree that holds the change." \
        '{systemMessage: $message}'
    exit 0
fi

fingerprint="$(working_tree_fingerprint "$project_dir")"
passed_marker="$(git -C "$project_dir" rev-parse --absolute-git-dir)/agents-stop-gate-passed"
if [[ -e "$passed_marker" && "$(<"$passed_marker")" == "$fingerprint" ]]; then
    exit 0
fi

mkdir -p "$STATE_DIR"
counter="$STATE_DIR/$session_id"

# stdout and stderr are merged on purpose: the agent needs the whole report.
if output="$(cd "$project_dir" && bash "$checks" 2>&1)"; then
    rm -f "$counter"
    echo "$fingerprint" >"$passed_marker"
    exit 0
fi

blocks=0
[[ -e "$counter" ]] && blocks="$(<"$counter")"
blocks=$((blocks + 1))
echo "$blocks" >"$counter"

if ((blocks > MAX_BLOCKS)); then
    rm -f "$counter"
    jq -n --arg message "stop-gate: checks still fail after $MAX_BLOCKS attempts, letting the agent stop. Run $checks to see why." \
        '{systemMessage: $message}'
    exit 0
fi

{
    echo "Checks failed (attempt $blocks of $MAX_BLOCKS). Fix the cause, then finish."
    echo "Ran: $checks"
    echo
    tail -n "$OUTPUT_LINES" <<<"$output"
} >&2
exit 2
