[
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-`": "terminal_panel::ToggleFocus"
    }
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "space r": "task::Spawn",
      "space shift-r": "task::Spawn",
      "space d": "debugger::Start",
      "space b": "editor::ToggleBreakpoint",
      "space g d": "editor::GoToDefinition",
      "ctrl-]": "editor::GoToDefinition",
      "ctrl-t": "pane::GoBack"
    }
  },
  {
    "context": "Editor && vim_mode == normal && extension == go && !menu",
    "bindings": {
      "space r": [
        "task::Spawn",
        {
          "task_name": "Run Go project"
        }
      ],
      "space shift-r": [
        "task::Spawn",
        {
          "task_name": "Test Go project"
        }
      ]
    }
  },
  {
    "context": "Editor && vim_mode == normal && extension == py && !menu",
    "bindings": {
      "space r": [
        "task::Spawn",
        {
          "task_name": "Run Python file"
        }
      ],
      "space shift-r": [
        "task::Spawn",
        {
          "task_name": "Test Python project"
        }
      ]
    }
  }
]
