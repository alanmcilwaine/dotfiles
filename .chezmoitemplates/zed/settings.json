{
{{- if hasKey . "copilotEnterpriseUri" }}
  "copilot": {
    "enterprise_uri": {{ .copilotEnterpriseUri | quote }}
  },
{{- end }}
  "edit_predictions": {
    "provider": "copilot",
    "allow_data_collection": "no"
  },
  "agent": {
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": false
    },
    "terminal_init_command": "",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false,
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "golangci-lint": true,
    "html": true
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    }
  },
  "languages": {
    "Go": {
      "language_servers": ["gopls", "golangci-lint"]
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "warning"
    }
  },
  "vim_mode": true,
  "theme": "Gruvbox Dark",
  "buffer_font_family": "MonoLisa Nerd Font",
  "buffer_font_size": 15,
  "terminal": {
    "font_family": "MonoLisa Nerd Font",
    "font_size": 15
  }
}
