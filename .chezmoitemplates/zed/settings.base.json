{
  "edit_predictions": {
    "mode": "eager",
    "provider": "copilot",
    "allow_data_collection": "no"
  },
  "agent": {
    "notify_when_agent_waiting": "never",
    "inline_assistant_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": false
    },
    "terminal_init_command": "",
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  },
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "ultracode": false,
        "model": "claude-fable-5-2[1m]",
        "fast": false,
        "mode": "bypassPermissions"
      },
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "golangci-lint": true,
    "html": true
  },
  "lsp": {
    "golangci-lint": {
      "initialization_options": {
        "command": [
          "golangci-lint",
          "run",
          "--output.json.path",
          "stdout",
          "--show-stats=false",
          "--output.text.path="
        ]
      }
    }
  },
  "languages": {
    "Go": {
      "language_servers": [
        "gopls",
        "golangci-lint"
      ]
    }
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": "warning"
    }
  },
  "vim_mode": true,
  "theme": "Gruvbox Dark",
  "buffer_font_family": "MonoLisa Nerd Font",
  "buffer_font_size": 13.0,
  "terminal": {
    "font_family": "MonoLisa Nerd Font",
    "font_size": 12.0
  }
}
